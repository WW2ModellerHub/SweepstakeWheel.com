{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sweepstake Wheel event data",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "slug",
      "name",
      "shortName",
      "category",
      "headline",
      "intro",
      "options"
    ],
    "properties": {
      "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 2 },
      "shortName": { "type": "string", "minLength": 2 },
      "category": { "type": "string", "minLength": 2 },
      "headline": { "type": "string", "minLength": 8 },
      "intro": { "type": "string", "minLength": 20 },
      "mode": { "enum": ["secret-santa-draw"] },
      "options": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      },
      "promotion": {
        "type": "object",
        "required": ["priority", "windows"],
        "properties": {
          "priority": { "type": "number" },
          "windows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "string", "pattern": "^[0-1][0-9]-[0-3][0-9]$" },
                "end": { "type": "string", "pattern": "^[0-1][0-9]-[0-3][0-9]$" },
                "years": { "type": "array", "items": { "type": "integer" } }
              }
            }
          }
        }
      },
      "dataStatus": {
        "type": "object",
        "properties": {
          "mode": { "type": "string" },
          "status": { "type": "string" },
          "sourceName": { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "edition": { "type": "string" },
          "checkedAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "expectedMin": { "type": "number" },
          "expectedMax": { "type": "number" }
        }
      }
    }
  }
}
